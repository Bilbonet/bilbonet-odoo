<odoo noupdate="1">
    <function name="write" model="ir.model.data">
        <function name="search" model="ir.model.data">
            <value
                eval="[('module', '=', 'stock'), ('name', '=', 'mail_template_data_delivery_confirmation')]"
            />
        </function>
        <value eval="{'noupdate': False}" />
    </function>
    <record id="stock.mail_template_data_delivery_confirmation" model="mail.template">
        <field name="partner_to">
            {{ ','.join(map(str, object.partner_id.mail_addresses_picking.ids)) or object.partner_id.email and object.partner_id.id or object.partner_id.parent_id.id }}
        </field>
    </record>
    <function name="write" model="ir.model.data">
        <function name="search" model="ir.model.data">
            <value
                eval="[('module', '=', 'stock'), ('name', '=', 'mail_template_data_delivery_confirmation')]"
            />
        </function>
        <value eval="{'noupdate': True}" />
    </function>
</odoo>
