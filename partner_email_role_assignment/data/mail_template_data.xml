<odoo noupdate="1">
    <!--
    Extend email templates to include partner role-based email recipients.
    -->
    <function name="write" model="ir.model.data">
        <function name="search" model="ir.model.data">
            <value
                eval="[('module', '=', 'sale'), ('name', '=', 'email_template_edi_sale')]"
            />
        </function>
        <value eval="{'noupdate': False}" />
    </function>
    <record id="sale.email_template_edi_sale" model="mail.template">
        <field
            name="partner_to"
        >{{ ','.join(map(str, object.partner_id.mail_addresses_sale.ids)) or object.partner_id.id }}</field>
    </record>
    <function name="write" model="ir.model.data">
