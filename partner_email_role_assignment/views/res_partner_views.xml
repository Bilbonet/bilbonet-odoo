<odoo>
    <!-- res.partner -->
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='contact_addresses']" position="after">
                <page string="Mail Addresses" name="mail_addresses">
                    <group>
                        <group string="Sales" name="sales" priority="1">
                            <field
                                name="mail_addresses_sale"
                                widget="many2many_tags"
                                readonly="True"
                                options="{'no_create': True}"
                            />
                        </group>
                        <group string="Invoicing" name="invoicing" priority="2">
                            <field
                                name="mail_addresses_invoice"
                                widget="many2many_tags"
                                readonly="True"
                                options="{'no_create': True}"
                            />
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath
                expr="//page[@name='contact_addresses']//field[@name='child_ids']/form//field[@name='name']/../.."
                position="before"
            >
                <div
                    name="email_role_assignment_roles"
                    class="row g-3 align-items-stretch mb-3"
                >
                    <div
                        name="email_role_assignment_sale"
                        class="col-lg-4 col-md-6 col-12"
                    >
                        <div
                            class="d-flex justify-content-between align-items-center border rounded px-3 py-2 h-100"
                        >
                            <label for="used_address_sale" class="mb-0" />
                            <field
                                name="used_address_sale"
                                widget="boolean_toggle"
                                class="oe_inline"
                            />
                        </div>
                    </div>
                    <div
                        name="email_role_assignment_invoice"
                        class="col-lg-4 col-md-6 col-12"
                    >
                        <div
                            class="d-flex justify-content-between align-items-center border rounded px-3 py-2 h-100"
                        >
                            <label for="used_address_invoice" class="mb-0" />
                            <field
                                name="used_address_invoice"
                                widget="boolean_toggle"
                                class="oe_inline"
                            />
                        </div>
                    </div>
                </div>
                <hr />
            </xpath>
        </field>
    </record>
</odoo>
