<odoo>
    <record id="tbai_invoice_form" model="ir.ui.view">
        <field name="model">tbai.invoice</field>
        <field name="inherit_id" ref="l10n_es_ticketbai.tbai_invoice_form"/> 
        <field name="arch" type="xml">
            <field name="invoice_id" position="attributes">
                <attribute name="attrs">{'invisible': [('invoice_id', '=', False)]}</attribute>
            </field>
            <field name="invoice_id" position="after">
                <field name="pos_order_id" readonly="1" attrs="{'invisible': [('pos_order_id', '=', False)]}"/>
            </field>
        </field>
    </record>
</odoo>