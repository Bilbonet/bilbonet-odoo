<odoo>
    <data>
        <record id="timesheet_employee_cost_view_list" model="ir.ui.view">
            <field name="model">timesheet.employee.cost</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="sequence" widget="handle" />
                    <field name="name" />
                    <field
                        name="employee_cost"
                        widget="monetary"
                        options="{'currency_field': 'currency_id'}"
                    />
                    <field name="active" widget="boolean_toggle" />
                    <field name="currency_id" invisible="1" />
                </tree>
            </field>
        </record>

        <record id="timesheet_employee_cost_view_form" model="ir.ui.view">
            <field name="model">timesheet.employee.cost</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="sequence" />
                            <field name="name" />
                        </group>
                        <group>
                            <field name="active" />
                            <field name="employee_cost" />
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="timesheet_employee_cost_action" model="ir.actions.act_window">
            <field name="name">Timesheet Employee Cost</field>
            <field name="res_model">timesheet.employee.cost</field>
            <field name="view_mode">tree</field>
        </record>

        <menuitem
            id="menu_timesheet_employee_cost_tree"
            action="timesheet_employee_cost_action"
            parent="hr.menu_human_resources_configuration"
            sequence="15"
            groups="hr_timesheet.group_timesheet_manager"
        />

    </data>
</odoo>
